# BELL Campaign 設定範例
PORT=21105
HOST=127.0.0.1
BELL_CAMPAIGN_DATA_DIR=./data

# 瀏覽器切換器與交接目標（逗號分隔 appId=origin）
BELL_CAMPAIGN_SUITE_LINKS=personal=http://127.0.0.1:21103,explain=http://127.0.0.1:21101,reader=http://127.0.0.1:21104

# 選用：非 loopback Tailscale HTTPS 允許來源
# BELL_CAMPAIGN_ALLOWED_ORIGINS=https://host.tailnet.ts.net:20005

# 選用：OpenAI 相容 API（未設定時支援本機 Codex / Claude / Antigravity CLI 與內建排程引擎）
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
